# Optional. When set, the server uses the official YouTube Data API v3.
# Without it the app falls back to a keyless server-side search.
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
YOUTUBE_API_KEY=

# Canonical site URL used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nostalgic-eight.vercel.app

# Razorpay Standard Checkout configuration.
# NEVER prefix RAZORPAY_KEY_SECRET with NEXT_PUBLIC_ — it must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

